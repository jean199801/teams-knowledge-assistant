{
  "name": "teams-knowledge-assistant",
  "version": "0.1.0",
  "description": "A Microsoft Teams RAG bot that searches your team's KM (Wiki.js), Google Docs, and Notion to answer questions, with built-in note-taking, reminders, and write-back to the knowledge base.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sync": "tsx scripts/run-sync.ts"
  },
  "keywords": [
    "teams-bot",
    "rag",
    "knowledge-management",
    "wiki-js",
    "notion",
    "google-docs",
    "azure-openai",
    "vector-search"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.31.0",
    "@notionhq/client": "^5.15.0",
    "applicationinsights": "^3.14.0",
    "botbuilder": "^4.23.1",
    "botbuilder-core": "^4.23.1",
    "botframework-connector": "^4.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "googleapis": "^171.4.0",
    "mammoth": "^1.12.0",
    "mssql": "^11.0.1",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
