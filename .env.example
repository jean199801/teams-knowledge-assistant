# ============================================================
# Teams Knowledge Assistant — environment template
# Copy this to .env and fill in the values.
# ============================================================

# --- Bot branding ---
BOT_DISPLAY_NAME=Teams Knowledge Assistant
# BOT_SYSTEM_PROMPT can be a multi-line prompt; the literal {context} placeholder
# will be replaced with retrieved knowledge chunks. Leave blank to use the default.
# BOT_SYSTEM_PROMPT=

# --- Server ---
PORT=3200
NODE_ENV=production

# --- Azure OpenAI (required) ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Deployment names you created in Azure OpenAI Studio
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Microsoft Teams Bot (required for Teams integration) ---
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# --- Knowledge source 1: Wiki.js / KM (SQL database) ---
# Leave blank to disable.
KM_DB_SERVER=
KM_DB_NAME=wiki
KM_DB_USER=
KM_DB_PASSWORD=
KM_DB_AUTH_TYPE=sql
# Public base URL used when generating source links in answers (e.g. https://wiki.example.com/zh-tw)
KM_BASE_URL=

# --- Wiki.js GraphQL API (for write-back: #edit / #append / #publish) ---
# Generate an API key in Wiki.js → Administration → API Access
WIKIJS_API_URL=
WIKIJS_API_TOKEN=

# --- Knowledge source 2: Google Docs ---
# Path to a Google Cloud service account JSON key file.
# The service account needs read access to the target Drive folder.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-sa-key.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Knowledge source 3: Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
# Share the parent page(s) you want to index with the integration.
NOTION_API_KEY=
# Comma-separated status values to filter on (empty = sync all pages)
# e.g. NOTION_STATUS_FILTER=Done,Published
NOTION_STATUS_FILTER=

# --- Publish targets (where user notes can be published to) ---
# Notion parent page ID for publish destination (32-char hex, no dashes)
NOTION_PUBLISH_PARENT_PAGE_ID=
# Google Drive folder ID for publish destination
GOOGLE_DOCS_PUBLISH_FOLDER_ID=
DEFAULT_PUBLISH_TARGET=km

# --- Image storage (Azure Blob Storage, optional) ---
# Used for user-uploaded images attached to notes/reminders.
# Set the container to PRIVATE; SAS tokens are generated per-render.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=note-images
AZURE_BLOB_SAS_DURATION_MINUTES=60

# --- RAG tuning ---
RAG_TOP_K=5
# Source boost added to cosine similarity (range 0.0 - 0.2 is reasonable)
RAG_BOOST_NOTION=0.05
RAG_BOOST_GOOGLE_DOCS=0.03
RAG_BOOST_KM=0

# --- Persistence paths (IMPORTANT for cloud deployments) ---
# On Azure App Service, point these to D:\home\data\... (not wwwroot)
# Otherwise zip-deploy wipes vector store and user data.
# VECTOR_STORE_PATH=
# SYNC_STATE_PATH=
# PERSONAL_DATA_DIR=
# PERSONAL_CONV_REFS_PATH=
# EDIT_SESSIONS_PATH=
# DAILY_REMINDER_STATE_PATH=

# --- Cron schedules ---
# Daily reminder digest push (defaults to Mon-Fri 09:00 local time).
# The bot uses a polling safety net (every 10 minutes) on top of cron because
# long-running node-cron processes can silently miss schedules. The polling
# checks the daily-reminder-state file and fires anything that should have run.
DAILY_REMINDER_CRON=0 9 * * 1-5

# --- Webhook secret for /api/sync (manual sync trigger) ---
SYNC_SECRET=change-me-to-a-random-string

# --- Telemetry (optional, Azure Application Insights) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
